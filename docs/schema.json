    "sectionOrder": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "colors": {
      "type": "object",
      "properties": {
        "background": {
