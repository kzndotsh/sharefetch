    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "subject": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "subject",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "source": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "manual",
            "paste",
            "json",
            "cli",
            "import"
          ]
        },
        "rawHash": {
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "specVersion",
    "title",
    "displayName",
    "handle",
    "visibility",
    "desktop",
    "utils",
    "layers",
    "sectionOrder",
    "tags"
  ],
  "additionalProperties": {}
}
